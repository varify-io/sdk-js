{
  "name": "varify-sdk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint && oxfmt --check .",
    "format": "oxfmt .",
    "check:package": "turbo run check:package",
    "prepare": "husky",
    "renovate": "docker run --rm -v \"$PWD:/usr/src/app\" -w /usr/src/app ghcr.io/renovatebot/renovate:44.93.6 --platform=local",
    "renovate:dry-run": "pnpm renovate --dry-run=lookup"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@lerna-lite/cli": "5.8.0",
    "@lerna-lite/publish": "5.8.0",
    "@lerna-lite/version": "5.8.0",
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "24.19.2",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "husky": "9.1.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "publint": "0.3.25",
    "tsdown": "0.23.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
