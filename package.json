    "@lerna-lite/publish": "5.9.0",
    "@lerna-lite/version": "5.9.0",
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "24.19.2",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "husky": "9.1.7",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "turbo": "2.11.13",
