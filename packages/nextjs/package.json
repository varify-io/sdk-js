{
  "name": "@varify-io/nextjs",
  "version": "0.0.0",
  "description": "Varify server-side A/B testing for Next.js App Router.",
  "homepage": "https://gitlab.com/varify/varify-sdk-js/-/tree/main/packages/nextjs#readme",
  "bugs": "https://gitlab.com/varify/varify-sdk-js/-/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/varify/varify-sdk-js.git",
    "directory": "packages/nextjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint && attw --pack . --profile esm-only && api-extractor run --local && api-extractor run --local -c api-extractor.client.json"
  },
  "dependencies": {
    "@varify-io/core": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "next": ">=15.5",
    "react": ">=19"
  },
  "engines": {
    "node": ">=20"
  }
}
