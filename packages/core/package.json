{
  "name": "@varify-io/core",
  "version": "0.1.1",
  "description": "Framework-agnostic core of the Varify server-side SDK: local evaluation, sticky assignments, config loading.",
  "homepage": "https://github.com/varify-io/sdk-js/tree/main/packages/core#readme",
  "bugs": "https://github.com/varify-io/sdk-js/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varify-io/sdk-js.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint && attw --pack . && api-extractor run --local"
  },
  "engines": {
    "node": ">=20"
  }
}
