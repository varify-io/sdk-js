{
  "name": "@varify-io/core",
  "version": "0.0.0",
  "description": "Framework-agnostic core of the Varify server-side SDK: local evaluation, sticky assignments, config loading.",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint && attw --pack ."
  },
  "engines": {
    "node": ">=20"
  }
}
